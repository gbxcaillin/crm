# Copy to .env.production next to docker-compose.yml and fill in.
# Only APP_URL and DATA_KEYS are required to go live; everything else turns a
# feature on when its values are present. See ../../SECURITY.md for the key.

APP_URL=https://crm.CLIENTDOMAIN.com

# Encryption at rest — REQUIRED. Generate once, keep a copy off the server:
#   docker compose run --rm crm node server/tools/keygen.js
DATA_KEYS=v1:PASTE_KEYGEN_OUTPUT_HERE

# Leave blank for an empty workspace (recommended for a real client), or set to
# 1 once to load sample data for a walkthrough.
DEMO_DATA=

# --- Email: Microsoft 365 mailbox with SMTP AUTH enabled --------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=pipeline@CLIENTDOMAIN.com
SMTP_PASS=
MAIL_FROM="ClientName Pipeline <pipeline@CLIENTDOMAIN.com>"

# --- Google Ads lead form webhook ------------------------------------------
# Any long random string; paste the same value into Google Ads.
GOOGLE_ADS_KEY=

# --- Meta Lead Ads ----------------------------------------------------------
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=

# --- SharePoint files + optional Graph email/backup (Azure app registration) -
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=CLIENTNAME.sharepoint.com:/sites/Clients
SP_LIBRARY=Client Files

# --- Microsoft 365 single sign-on (Entra ID) -------------------------------
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_TENANT=
