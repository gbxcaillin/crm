# Copy to /root/crm/.env.production on the VPS and fill in what you use.
# Everything is optional except APP_URL; features switch on when their keys are set.

APP_URL=https://crm.gbxps.com

# First admin. Only used when the database is empty; otherwise the app shows a
# "Create the first admin" form on first visit, so you can leave these blank.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Load the sample deals/tasks/chat into a brand-new workspace (1 = yes). Leave
# blank for a clean workspace with just the stages, fields and preferences.
DEMO_DATA=

# --- Email (choose one) ---------------------------------------------------
# A. SMTP (Microsoft 365: smtp.office365.com:587, a mailbox with SMTP AUTH on)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GBX Pipeline <pipeline@gbxps.com>"
# B. Microsoft Graph sendMail (needs MS_* below with Mail.Send). Set MAIL_MODE=graph
#    and MAIL_FROM to the sending mailbox address.
MAIL_MODE=

# --- Microsoft Graph / SharePoint (Azure app registration, application permissions:
#     Sites.Selected or Sites.ReadWrite.All; Mail.Send for Graph email) -----------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=gbxps.sharepoint.com:/sites/Clients
SP_LIBRARY=Client Files

# --- Web push. Generated automatically into /app/data/vapid.json if blank. ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cc@gbxps.com

# --- Lead sources ------------------------------------------------------------
# Google Ads lead form webhook "key" (any long random string; paste the same in Google Ads).
GOOGLE_ADS_KEY=
# Meta Lead Ads webhook: verify token you choose, the app secret, and a long-lived
# page access token with leads_retrieval so lead details can be fetched.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
